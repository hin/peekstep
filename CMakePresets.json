{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (static deps)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-release",
        "VCPKG_HOST_TRIPLET": "x64-linux-release"
      }
    },
    {
      "name": "mingw",
      "displayName": "Windows, MSYS2 UCRT64 (static)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static-release",
        "VCPKG_HOST_TRIPLET": "x64-mingw-static-release"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS 13+, Apple Silicon (static deps)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-peekstep",
        "VCPKG_HOST_TRIPLET": "arm64-osx-peekstep",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "mingw",
      "configurePreset": "mingw"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    }
  ]
}
