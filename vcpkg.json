{
  "name": "peekstep",
  "version-string": "0.1.1",
  "description": "A fast-starting STEP file viewer",
  "license": "BSD-2-Clause",
  "builtin-baseline": "74f5ea45ca78988784b810ad9bbb148ea7ff76d8",
  "vcpkg-configuration": {
    "overlay-triplets": [ "cmake/triplets" ]
  },
  "dependencies": [
    "glfw3",
    {
      "name": "imgui",
      "features": [ "glfw-binding", "vulkan-binding" ]
    },
    {
      "name": "opencascade",
      "default-features": false
    },
    {
      "name": "glslang",
      "host": true,
      "features": [ "tools" ]
    }
  ]
}
